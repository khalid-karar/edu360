# Copy to .env (never commit it). Generate each key with: openssl rand -hex 32
DATABASE_URL=postgres://ilmak:change-me@127.0.0.1:5432/ilmak
PROVIDERS=mock
PORT=3000
# Keyed hash of national IDs. Must never change once real users exist.
ID_HASH_KEY=
# Encrypts staff authenticator secrets.
MFA_ENC_KEY=
# Optional; one-time-code hashing key (random per boot if empty).
OTP_KEY=
