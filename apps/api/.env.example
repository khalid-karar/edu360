# Copy to .env (never commit it). Generate each key with: openssl rand -hex 32
DATABASE_URL=postgres://ilmak:change-me@127.0.0.1:5432/ilmak
PROVIDERS=mock
PORT=3000
# Keyed hash of national IDs. Must never change once real users exist.
ID_HASH_KEY=
# Encrypts staff authenticator secrets.
MFA_ENC_KEY=
# Optional; one-time-code hashing key (random per boot if empty).
OTP_KEY=

# Payments: mock (default) or moyasar. Moyasar needs both values; test in their sandbox before using real keys.
PAYMENTS=mock
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

# Lesson rooms: mock (default) or livekit
VIDEO=mock
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Shared rate-limit counters. Optional: without it each API process counts on its own (fine for one process).
# If Redis goes down the limiter falls back to per-process memory instead of failing requests.
REDIS_URL=

# Teacher credential scans (pdf, png, jpeg). Stored on this machine's disk for now; move to Oracle Object Storage later.
UPLOAD_DIR=./data/storage
UPLOAD_MAX_BYTES=5000000
