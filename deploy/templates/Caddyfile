# Replace the host with the real domain. Caddy gets and renews the certificate by itself; ports 80 and 443 must be open.
app.example.sa {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Metrics are for the server's own scraper only, never the internet.
	@metrics path /api/metrics
	respond @metrics 404

	# Live chat: reverse_proxy upgrades WebSocket connections on its own, so /api/ws needs no special rule.
	# Real client address for the rate limiter. Caddy sets X-Forwarded-For itself; the API must only be reachable through Caddy.
	handle /api/* {
		reverse_proxy 127.0.0.1:3000 {
			health_uri /api/ready
			health_interval 15s
		}
	}

	handle {
		root * /opt/ilmak/apps/web/out
		header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}.html {path}/index.html
		file_server
	}
}
