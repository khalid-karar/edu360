# /etc/ilmak/ilmak.env  (chmod 600, owner root; systemd reads it, the ilmak user never does)
# Generate every key with: openssl rand -hex 32   — and keep a copy in a password manager. Losing MFA_ENC_KEY locks every staff member out.

PORT=3000
DATABASE_URL=postgres://ilmak:CHANGE_ME@127.0.0.1:5432/ilmak
ID_HASH_KEY=
MFA_ENC_KEY=
OTP_KEY=

# Real providers are not wired yet; the API refuses to start with anything but mock for these.
PROVIDERS=mock
PAYMENTS=mock
VIDEO=mock

# Sessions are an HttpOnly cookie. Keep Secure on: it needs https, which Caddy provides.
COOKIE_SECURE=true
# Only needed if the web app is served from a different origin than the API (not the case behind one Caddy).
ALLOWED_ORIGINS=

# Shared rate limits and live chat across API processes. Optional with one process.
REDIS_URL=redis://127.0.0.1:6379

# Uploads. Local disk is for a single test machine; production uses the private Object Storage bucket below.
UPLOAD_DIR=/var/lib/ilmak/uploads
UPLOAD_MAX_BYTES=5000000
UPLOAD_VIDEO_MAX_BYTES=50000000
#S3_BUCKET=ilmak-private
#S3_ENDPOINT=https://NAMESPACE.compat.objectstorage.me-riyadh-1.oraclecloud.com
#S3_REGION=me-riyadh-1
#S3_ACCESS_KEY=
#S3_SECRET_KEY=

# Antivirus (ClamAV daemon). When set, a file is refused if the scanner cannot be reached.
#CLAMD_HOST=127.0.0.1
#CLAMD_PORT=3310

# Prometheus scrape token (16+ characters). Without it /api/metrics does not exist.
#METRICS_TOKEN=
